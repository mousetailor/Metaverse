{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "NodeNext",
    "moduleDetection":"force",
    "moduleResolution":"NodeNext",
    "target": "es2020",
    "esModuleInterop": true,
    "types": ["node"],
    "strict": false,
    "skipLibCheck": true,
    "sourceMap": true
  }
}
